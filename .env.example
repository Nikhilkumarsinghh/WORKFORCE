# Copy to .env.local and fill in. Every form on the site emails NOTIFY_EMAIL.
NOTIFY_EMAIL=nikhilkauriya04@gmail.com

# Recommended: Gmail SMTP (reliable). Create an App Password: Google Account > Security > 2-Step Verification > App passwords.
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Database (leads, applications, jobs, admin). MongoDB Atlas free tier works.
MONGODB_URI=
MONGODB_DB=uniquetoo

JWT_SECRET=change_me_to_a_long_random_string
IP_HASH_SALT=change_me_to_another_random_string
NEXT_PUBLIC_SITE_URL=https://uniquetoo.in

# Only after Google AdSense gives you the real publisher ID:
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
